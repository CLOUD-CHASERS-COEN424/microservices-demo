{
  "openapi": "3.0.3",
  "info": {
    "title": "RecEngine-AI: Autonomous Cross-Sell & Bundling SaaS API",
    "description": "B2B AI Agent API (Option B - COEN 424). Provides context-aware product recommendations via NVIDIA Nemotron 3.5 Lightning (OpenRouter) tool-calling and Cloud Firestore NoSQL.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local RecommendationService v2 Server"
    }
  ],
  "paths": {
    "/api/v1/recommendations": {
      "post": {
        "tags": [
          "AI Merchandising Agent"
        ],
        "summary": "Generate Recommendations",
        "operationId": "generate_recommendations_api_v1_recommendations_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              },
              "example": {
                "user_id": "user-concordia-99",
                "product_ids": [
                  "OLJCESPC7Z",
                  "66VCHSJNUP"
                ],
                "max_results": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                },
                "example": {
                  "user_id": "user-concordia-99",
                  "recommended_product_ids": [
                    "1YMWWN1N4O",
                    "L9ECAV7KIM",
                    "2ZYFJ3GM2N",
                    "0PUK6V6EV0",
                    "LS4PSXUNUM"
                  ],
                  "served_by_version": "v2-ai-agent",
                  "reasoning_summary": "Queried Firestore profile for 'user-concordia-99' and inspected cart items via ProductCatalogService; selected complementary fashion and lifestyle bundle.",
                  "tokens_used": 415,
                  "estimated_cost_usd": 0.0,
                  "latency_ms": 412.5
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}": {
      "get": {
        "tags": [
          "NoSQL Session Data Model"
        ],
        "summary": "Get User Session Profile",
        "description": "Inspect a shopper's session profile and AI agent context stored in Cloud Firestore NoSQL.",
        "operationId": "get_user_session_profile_api_v1_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "user-concordia-99"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "user_id": "user-concordia-99",
                  "category_affinity": "vintage photography & retro electronics",
                  "past_purchased_skus": [
                    "OLJCESPC7Z"
                  ],
                  "price_sensitivity": "medium",
                  "last_recommended_skus": [
                    "1YMWWN1N4O",
                    "L9ECAV7KIM",
                    "2ZYFJ3GM2N",
                    "0PUK6V6EV0",
                    "LS4PSXUNUM"
                  ],
                  "nosql_source": "cloud-firestore"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "SERVING",
                  "version": "v2-ai-agent",
                  "nosql_connected": true,
                  "nosql_backend": "cloud-firestore"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "RecommendationRequest": {
        "type": "object",
        "required": [
          "user_id",
          "product_ids"
        ],
        "title": "RecommendationRequest",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Unique shopper ID for Firestore session lookup",
            "example": "user-concordia-99"
          },
          "product_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of SKU IDs currently in the user's cart",
            "example": [
              "OLJCESPC7Z",
              "66VCHSJNUP"
            ]
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        }
      },
      "RecommendationResponse": {
        "type": "object",
        "required": [
          "user_id",
          "recommended_product_ids",
          "served_by_version",
          "reasoning_summary",
          "tokens_used",
          "estimated_cost_usd",
          "latency_ms"
        ],
        "title": "RecommendationResponse",
        "properties": {
          "user_id": {
            "type": "string",
            "example": "user-concordia-99"
          },
          "recommended_product_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "1YMWWN1N4O",
              "L9ECAV7KIM",
              "2ZYFJ3GM2N",
              "0PUK6V6EV0",
              "LS4PSXUNUM"
            ]
          },
          "served_by_version": {
            "type": "string",
            "example": "v2-ai-agent"
          },
          "reasoning_summary": {
            "type": "string",
            "example": "Selected complementary fashion and lifestyle products via NVIDIA Nemotron 3.5 Lightning."
          },
          "tokens_used": {
            "type": "integer",
            "example": 415
          },
          "estimated_cost_usd": {
            "type": "number",
            "example": 0.0
          },
          "latency_ms": {
            "type": "number",
            "example": 412.5
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  }
}
