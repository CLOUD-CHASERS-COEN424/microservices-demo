{
  "openapi": "3.1.0",
  "info": {
    "title": "RecEngine-AI: Autonomous Cross-Sell & Bundling SaaS API",
    "description": "B2B AI Agent API (Option B - COEN 424). Provides context-aware product recommendations via Gemini tool-calling and Cloud Firestore NoSQL.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/recommendations": {
      "post": {
        "tags": [
          "AI Merchandising Agent"
        ],
        "summary": "Generate Recommendations",
        "operationId": "generate_recommendations_api_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Monitoring & Canary"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecommendationRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Unique shopper ID for Firestore session lookup",
            "example": "user-concordia-99"
          },
          "product_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Product Ids",
            "description": "List of SKU IDs currently in the user's cart",
            "example": [
              "OLJCESPC7Z",
              "66VCHSJNUP"
            ]
          },
          "max_results": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Results",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "product_ids"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "recommended_product_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommended Product Ids"
          },
          "served_by_version": {
            "type": "string",
            "title": "Served By Version",
            "example": "v2-ai-agent"
          },
          "reasoning_summary": {
            "type": "string",
            "title": "Reasoning Summary",
            "example": "Selected vintage camera lens and tripod based on vintage camera in cart."
          },
          "tokens_used": {
            "type": "integer",
            "title": "Tokens Used",
            "example": 340
          },
          "estimated_cost_usd": {
            "type": "number",
            "title": "Estimated Cost Usd",
            "example": 5.1e-05
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "example": 412.5
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "recommended_product_ids",
          "served_by_version",
          "reasoning_summary",
          "tokens_used",
          "estimated_cost_usd",
          "latency_ms"
        ],
        "title": "RecommendationResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}